# =============================================================================
# Variáveis de Ambiente — Template
# =============================================================================
# Copie este arquivo para .env e preencha com os valores reais:
#   cp .env.example .env
#
# NUNCA commite o arquivo .env com credenciais reais no repositório!
# =============================================================================

# ---------------------------------------------------------------------------
# Banco de Dados (PostgreSQL)
# ---------------------------------------------------------------------------
DB_HOST=database
DB_PORT=5432
DB_NAME=gestao_uep
DB_USER=postgres
DB_PASS=SUA_SENHA_SEGURA_AQUI
DB_EXTERNAL_PORT=5432

# ---------------------------------------------------------------------------
# Backend — API
# ---------------------------------------------------------------------------
API_PORT=8080
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=SUA_CHAVE_JWT_SECRETA_AQUI
API_BASE_URL=http://localhost:8080
# Origem acessada no Compose (porta padrão 80); convites usam este endereço.
# Se alterar FRONTEND_PORT, informe também a porta aqui, por exemplo http://localhost:8081.
FRONTEND_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
GOOGLE_CLIENT_ID=SEU_CLIENT_ID_WEB_DO_GOOGLE.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# Primeiro ADMIN (opcional)
# Preencha ambos no .env antes de iniciar o backend com docker compose up -d.
# Após o primeiro provisionamento, as duas entradas podem ser removidas do .env.
# O bootstrap preserva contas e senhas quando já existe um ADMIN.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------------------
# E-mail de confirmacao
# ---------------------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@belojardim.ifpe.edu.br
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
FRONTEND_PORT=80
VITE_API_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=SEU_CLIENT_ID_WEB_DO_GOOGLE.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# Geral
# ---------------------------------------------------------------------------
TZ=America/Sao_Paulo
LOG_LEVEL=info
